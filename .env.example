# =============================================================================
# Maroon Traceability (Next.js) — copy to .env.local (never commit .env.local)
# =============================================================================
#
# Cross-app URLs (Varydian ↔ Maroon):
#   • THIS app must set NEXT_PUBLIC_FINANCE_APP_URL → Varydian base URL
#     (no trailing slash). Used for “Launch Varydian”, footer, government card, etc.
#
#   • MAROON_APP_URL belongs ONLY on the Varydian (Flask/Render) deployment,
#     for “back to Maroon” nav. Do not define MAROON_APP_URL here unless you add
#     code to read it — the Maroon codebase does not use that variable today.
#
# =============================================================================

# Environment variables
NEXT_PUBLIC_APP_NAME="Maroon Blockchain"
NEXT_PUBLIC_APP_DESCRIPTION="Blockchain-based supply chain traceability"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000/api"

